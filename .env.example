# ==============================================================================
# RETROTAPRI — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and will NOT be pushed to GitHub.
#
# For deployment (Vercel/Netlify), add these same variables in:
#   Project Settings → Environment Variables
#
# NOTE: Playlists are defined directly in `script.js` — no env var needed.
# ==============================================================================

# Weather (OpenWeatherMap)
OPENWEATHER_API_KEY=
FALLBACK_LOCATION_NAME=Pune
FALLBACK_LAT=18.5204
FALLBACK_LON=73.8567

# Firebase Realtime Database (online count & likes)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Branding & Social Links
HERO_TITLE=रेट्रो टपरी
SPOTIFY_URL=
INSTAGRAM_URL=
GITHUB_URL=
