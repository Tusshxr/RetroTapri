# ==============================================================================
# RETROTAPRI ENVIRONMENT VARIABLES (REFERENCE & DEPLOYMENT GUIDE)
# ==============================================================================
#
# NOTE ON PLAYLISTS:
# You do NOT need any environment variable for playlists! All 6 playlists
# are defined directly inside `script.js` and work automatically when hosted.
#
# When hosting on Vercel or Netlify, add the following variables in your
# Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WEATHER & LOCATION (Optional)
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key for live weather chip & dynamic rain effects
OPENWEATHER_API_KEY=
FALLBACK_LOCATION_NAME=
FALLBACK_LAT=
FALLBACK_LON=

# ------------------------------------------------------------------------------
# 2. FIREBASE REALTIME DATABASE (For Live Online Count & Likes)
# ------------------------------------------------------------------------------
# Get these from Firebase Console -> Project Settings -> General -> Web Apps
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 3. BRANDING & SOCIAL LINKS (Optional Overrides)
# ------------------------------------------------------------------------------
HERO_TITLE=
SPOTIFY_URL=
INSTAGRAM_URL=
GITHUB_URL=

# ------------------------------------------------------------------------------
# 4. CUSTOM PLAYLISTS OVERRIDE (Optional JSON String)
# ------------------------------------------------------------------------------
# Only use this if you want to override the default 6 playlists from Vercel:
# PLAYLISTS_JSON=[{"id":"PLP7LBOIQKXnA4xVwRgtLc4l-_0BEt64O4","name":"Kishore Kumar","youtubeMusicUrl":"https://music.youtube.com/playlist?list=PLP7LBOIQKXnA4xVwRgtLc4l-_0BEt64O4"}]
